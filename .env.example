# Eastudy V3 — environment template.
#
# Copy to `.env` and fill in. `.env` is gitignored (see .gitignore); this file
# is the one exception to the `.env.*` rule, and it must stay free of real
# values.
#
# ---------------------------------------------------------------------------
# THREE different consumers read these variables, and they are not
# interchangeable. Read the one you are configuring.
# ---------------------------------------------------------------------------
#
# 1. The Cloudflare Pages project (`functions/`, and the built `src/` bundle).
#    On the deployed site these come from the Pages dashboard, NOT from this
#    file — and the secrets among them are marked "encrypt" there so they never
#    appear in the build log or the dashboard after saving.
#
#    Locally, `wrangler pages dev` reads them from `.dev.vars`, which is a
#    separate gitignored file. This template documents what belongs in it so
#    the two do not drift.
#
# 2. The build script (`tools/build.mjs`, run by `npm run build` /
#    `npm run check`). It reads the `EASTUDY_*` group and uses it to REWRITE
#    `public/env.js` into `dist/env.js`. See the section near the end of this
#    file.
#
#    These are the only variables the build needs, and they are read at build
#    time, not at runtime — setting them in the Pages dashboard does nothing
#    for them. If they are unset, the build still succeeds and writes an
#    `env.js` full of empty strings, which produces a site that boots to the
#    fatal-configuration screen. That is the single most likely way to get a
#    "deployed but broken" result.
#
# 3. The media worker (`services/worker/`, a long-running Python process).
#    It reads ordinary process environment variables — this file's variable
#    names are the ones it uses, but it does not parse `.env` itself. Export
#    them, or use your process manager's env file.
#
# ---------------------------------------------------------------------------
# Never in public/env.js
# ---------------------------------------------------------------------------
#
# `public/env.js` ships to the browser. It may contain the Supabase anon key
# and nothing else. Every value marked SECRET below is server-only. The build
# refuses to run if a service-role-shaped key (a `eyJ...` string over 200
# characters) appears in public/env.js, and tests/unit/environment.test.mjs
# asserts it — this is a rule with a check behind it, not a convention.

# ===========================================================================
# Supabase — read by both consumers
# ===========================================================================

# Project URL. Safe in the browser bundle.
SUPABASE_URL=https://<project>.supabase.co

# SECRET. Bypasses RLS entirely. Server-side only — Pages encrypted variable,
# or the worker host's environment. In public/env.js this would hand every
# visitor full read/write access to every table.
SUPABASE_SERVICE_ROLE_KEY=<server-only key>

# Public. Ships in public/env.js by design; RLS is what limits it.
SUPABASE_ANON_KEY=<anon / publishable key>

# ===========================================================================
# Signing secrets — Cloudflare Pages only
# ===========================================================================
#
# Both are HMAC keys over tokens this project mints and verifies itself. If
# either leaks, an attacker can forge that token type. Rotating one invalidates
# every outstanding token of that type, which is the intended panic button.

# SECRET. Signs playback tickets (functions/_lib/media-ticket.js). A ticket
# binds subject + video + R2 prefix + expiry, so a forged one grants access to
# any video's media.
PLAYBACK_TICKET_SECRET=<random 32+ bytes>

# SECRET. Authenticates the intake service to the API. The intake service binds
# to 127.0.0.1 only; this secret is the second lock on the same door.
INTAKE_HANDSHAKE_SECRET=<random 32+ bytes>

# --- Local intake service address ------------------------------------------

# Where the operator's browser (and the edge API's challenge endpoint) finds
# the intake service. Loopback only — it must never be exposed on a public
# interface, and the edge API cannot reach it anyway. This is an address, not a
# credential: the upload handshake is minted server-side per request.
#
# `functions/api/intake/challenge.js:51` and `public/env.js` both fall back to
# the same value, so this only needs setting for a non-default port.
INTAKE_PUBLIC_URL=http://127.0.0.1:8790/v3

# --- R2 binding (not a variable) -------------------------------------------

# `PROCESSING_BUCKET` is the R2 binding the media routes read
# (`functions/api/media/[[path]].js:37`), and it is declared in `wrangler.toml`
# under `[[r2_buckets]]` — currently commented out there, so it must be
# uncommented and pointed at a real bucket before `/api/media` works. A binding
# cannot be set from a file like this one; it is a resource reference, so it is
# listed here only so the name is not a surprise.

# ===========================================================================
# Media worker — services/worker (see services/worker/README.md)
# ===========================================================================

# Where the intake service drops receipts. The worker polls INTAKE_DATA/inbox.
INTAKE_DATA=./runtime/intake

# Identifies this worker in worker_heartbeats and in the lease it holds. Two
# workers MUST NOT share an id: the heartbeat table is keyed on it, so a
# duplicate id makes two processes look like one flapping one, and the admin
# page cannot tell you which host is stuck.
WORKER_ID=eastudy-worker-1

# Reported in worker_heartbeats.version; shown on the admin settings page.
WORKER_VERSION=3.0.0

# Job lease length in seconds. Clamped to [30, 3600] by worker_claim_job
# (0002_worker.sql). Too short duplicates expensive stages; too long delays
# recovery of a job whose host died. The worker renews on every stage
# transition, so this only has to exceed the gap between renewals.
WORKER_LEASE_SECONDS=300

# Idle poll interval, seconds.
WORKER_POLL_SECONDS=5

# Scratch directory for checkpoints (probe.json, transcript.json,
# subtitles.json) and staged output. Under runtime/, which is gitignored: it
# holds the operator's content.
WORK_ROOT=./runtime/worker

# --- R2 (media storage) ----------------------------------------------------
#
# The S3-compatible endpoint for the bucket the site serves media from. Same
# bucket the Pages project binds as PROCESSING_BUCKET.
R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com

# SECRET. R2 access key pair. The secret is write-capable over the media
# bucket; keep it off the Pages side entirely.
R2_ACCESS_KEY_ID=<r2 key>
R2_SECRET_ACCESS_KEY=<r2 secret>

# Bucket name. Default in code is empty (R2 is required for a real job).
R2_BUCKET=eastudy-v3-media-hk

# Key prefix inside the bucket. Objects land at
# {R2_PREFIX}/{video_id}/{job_id}/...
R2_PREFIX=videos

# --- AI (translation + keyword enrichment) ---------------------------------
#
# PRECEDENCE, and this is the part that matters:
#
#   The admin settings page writes to the `settings` table, key `ai`, and the
#   worker reads THAT first. The variables below are the fallback, used only
#   when the row is missing or the read fails. So a value typed into the
#   settings page wins over anything here — filling these in does not override
#   the console, it only covers the console being empty.
#
#   The effective source is logged once per change at startup:
#     "AI 配置来源: settings 表 (enabled=True, model=...)"
#
# The names are honored in the order shown; the AI_* aliases exist for a
# non-DeepSeek OpenAI-compatible endpoint.

# SECRET. Base URL of an OpenAI-compatible chat completions API. Point this at
# whatever provider you use — DeepSeek is the default, not a requirement.
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=<key>
DEEPSEEK_MODEL=deepseek-chat

# Aliases for the three above, checked only when the DEEPSEEK_* name is unset.
# Leave blank unless you are pointing at a non-DeepSeek endpoint.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Fallback kill switch. The settings page's toggle wins; this only decides the
# default when the row is absent. Set to `false` to publish subtitles with no
# translation when the upstream is not configured — the job then completes
# with pipeline_status=PARTIAL instead of failing at the AI stage.
AI_ENABLED=true

# --- faster-whisper (English ASR) ------------------------------------------
#
# Runs locally on the worker host; no API key. The model is downloaded at
# install time and loaded with local_files_only=True, so the worker never
# reaches the network for it.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

# Absolute path to prompts/prompts.json, if the worker's working directory is
# not the repo root. That file is the single source of truth for the AI
# instructions, shared with the admin console (src/admin/prompts.js).
PROMPTS_FILE=


# ===========================================================================
# Build-time — read by tools/build.mjs to rewrite dist/env.js
# ===========================================================================
#
# Set these in the shell (or CI environment) before `npm run build`. They are
# NOT read from the Pages dashboard and NOT read from `.dev.vars` at runtime.
#
# The names on the left are environment variables; the names in brackets are
# the keys build.mjs writes into `dist/env.js`, which is the file the browser
# actually reads (via src/config/environment.js). build.mjs matches the keys
# literally against the lines in `public/env.js`, so renaming one there without
# renaming it here makes the build throw rather than ship a half-written file.

# API origin. Leave EMPTY for a same-origin deploy (the normal case — Pages
# serves /api/* itself). Set it only when the API lives on another host.
# [apiBaseUrl]
EASTUDY_API_BASE=

# Where the operator's browser reaches the local intake service.
# [intakeUrl]
EASTUDY_INTAKE_URL=http://127.0.0.1:8790/v3

# The Supabase project URL. Same value as SUPABASE_URL above, but this is the
# copy that reaches the browser, so it is a separate variable on purpose.
# [supabaseUrl]
EASTUDY_SUPABASE_URL=

# PUBLIC. The anon / publishable key — the same value as SUPABASE_ANON_KEY
# above. This one is not a server secret; RLS is what protects the data.
#
# Do NOT put the service_role key here. build.mjs refuses to build if this
# value starts with `eyJ` and is longer than 200 characters, and
# tests/unit/environment.test.mjs asserts the same. EASTUDY_SUPABASE_PUBLISHABLE_KEY
# is accepted as an alias if you prefer that name.
# [supabasePublishableKey]
EASTUDY_SUPABASE_ANON_KEY=

# Free-text environment label that lands in `env.js` as `deployment`. Used by
# the verification step (`curl /env.js`) to confirm which environment you are
# actually looking at. Defaults to `local` when unset.
# [deployment]
EASTUDY_DEPLOYMENT=local

# Version string written into `env.js`. Defaults to the package.json version.
# [version]
EASTUDY_VERSION=3.0.0
