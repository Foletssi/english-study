# Build output. Regenerated by `npm run build`; committing it makes every deploy
# diff unreadable and invites editing the artifact instead of the source.
dist/

# Dependencies.
node_modules/

# Local secrets for `wrangler pages dev`. This is the file the local server
# reads for the service role key and the two signing secrets.
.dev.vars
.env
.env.*
!.env.example

# Wrangler's local state: KV/R2/D1 emulation, caches, logs.
.wrangler/
.wrangler.toml

# The intake service's runtime data — uploaded chunks, staged originals, and the
# token file it generates on first start. Never committed: it is content the
# operator uploaded, and the token is a credential.
runtime/

# Python.
__pycache__/
*.py[cod]
.venv/
venv/

# Editors.
.vscode/
.idea/
*.swp

# OS noise.
.DS_Store
Thumbs.db
desktop.ini
